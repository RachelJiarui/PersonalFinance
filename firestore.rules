rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function - check if user is Rachel
    function isRachel() {
      return request.auth != null && request.auth.token.email == 'rachel.j.chen@gmail.com';
    }

    // App Settings - read/write for Rachel
    match /app_settings/{document=**} {
      allow read, write: if isRachel();
    }

    // Budget Categories - read/write for Rachel
    match /budget_categories/{categoryId} {
      allow read, write: if isRachel();
    }

    // Transactions - read/write for Rachel
    match /transactions/{transactionId} {
      allow read, write: if isRachel();
    }

    // Transaction Alerts - read/write for Rachel
    match /transaction_alerts/{alertId} {
      allow read, write: if isRachel();
    }

    // Budget - read/write for Rachel
    match /budget/{document=**} {
      allow read, write: if isRachel();
    }

    // Snapshots - read/write for Rachel
    match /snapshots/{snapshotId} {
      allow read, write: if isRachel();
    }

    // Service account has full access (for backend operations)
    // Service accounts don't go through these rules

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
