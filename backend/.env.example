# Google Cloud Configuration
# Create service account and download credentials.json
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
GOOGLE_CLOUD_PROJECT=your-project-id
PUBSUB_TOPIC=gmail-notifications

# APNs Configuration
# Generate APNs certificate from Apple Developer Portal
# Convert to PEM format and save as apns_cert.pem and apns_key.pem
APNS_CERT_PATH=apns_cert.pem
APNS_KEY_PATH=apns_key.pem
APNS_BUNDLE_ID=com.yourcompany.BudgetInsight
APNS_USE_SANDBOX=true

# Server Configuration
PORT=8080
FLASK_ENV=production
SECRET_KEY=your-secret-key-here
